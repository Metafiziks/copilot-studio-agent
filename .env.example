# Copy to .env (gitignored) and fill in. Read by scripts/provision.sh and scripts/teardown.sh.

# --- required ---
# Your SharePoint hostname.
SP_HOST=contoso.sharepoint.com

# --- access mode (the equivalent of KB_ACCESS_MODE in the Azure template) ---
# sample    : uploads the sample corpus from docs/ to one site (use only for non-sensitive documents)
# protected : uploads only the two-user acceptance fixtures to two sites; requires the users below
KB_ACCESS_MODE=sample
# ALLOWED_USER=jane@contoso.com
# DENIED_USER=john@contoso.com

# --- optional (defaults shown) ---
# Extra members of the main site in sample mode, comma separated.
# KB_MEMBERS=
# ENV_NAME=copilot-agent-dev
# ENV_REGION=north-america        # north-america | europe-uk | asia-pacific | ...
# AGENT_NAME=OL Memory Agent      # must agree with agent/settings.mcs.yml (schema = prefix + name without spaces)
# PUBLISHER_PREFIX=olk
# KB_SITE_NICK=ol-knowledge
# KB_SITE_TITLE=OL Knowledge
# RESTRICTED_SITE_NICK=ol-restricted
# RESTRICTED_SITE_TITLE=OL Restricted

# --- evals (see README > Evaluations) ---
# From `bash scripts/setup_entra_app.sh`:
# EVAL_CLIENT_ID=
# EVAL_TENANT_ID=
# The agent the evals call (Copilot Studio > Settings > Advanced > Metadata):
# AGENT_ENVIRONMENT_ID=
# AGENT_SCHEMA_NAME=olk_OLMemoryAgent
# AGENT_TOKEN_CACHE=.build/token_cache.json   # per-user sign-in cache; use a different file per test user

# --- observability (see README > Observability) ---
# OBS_RESOURCE_GROUP=rg-copilot-agent-obs
# OBS_LOCATION=eastus2
# OBS_WORKSPACE=log-copilot-agent
# OBS_APPINSIGHTS=appi-copilot-agent
# OBS_DAILY_CAP_GB=1          # daily ingestion cap: bounds the cost
# OBS_RETENTION_DAYS=30

# --- Optional: LLM judge for relevance / completeness / faithfulness (scripts/judge.py) -----------------------
# Off unless a key is set. Any OpenAI-compatible chat-completions endpoint; use a different model family from
# the agent. In CI put the key in the `dev` environment as the secret JUDGE_API_KEY (and, optionally, the
# variables JUDGE_BASE_URL and JUDGE_MODEL). The HHEM faithfulness score needs no key, only PyTorch:
#   pip install -r requirements-hhem.txt --extra-index-url https://download.pytorch.org/whl/cpu
# JUDGE_API_KEY=
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_MODEL=gpt-4.1
